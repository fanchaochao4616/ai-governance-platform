# Copy to .env and fill in your real key:
#   copy .env.example .env   (Windows)
#   cp .env.example .env     (macOS/Linux)
#
# Get a key: https://console.x.ai

# Grok（有额度时 QC_PROVIDER=xai）
XAI_API_KEY=xai-your-key-here
XAI_BASE_URL=https://api.x.ai/v1
XAI_QC_MODEL=grok-4.5

# 质检：xai | deepseek（DeepSeek 作 Grok 备用）
QC_PROVIDER=deepseek
QC_BASE_URL=https://api.deepseek.com
QC_MODEL=deepseek-chat
QC_API_KEY=sk-your-deepseek-key
# DEEPSEEK_API_KEY=sk-your-deepseek-key

# 标注小模型可走本机 Ollama
ANNOTATOR_BASE_URL=http://127.0.0.1:11434/v1
ANNOTATOR_MODEL=qwen2.5:7b
ANNOTATOR_API_KEY=ollama
ANNOTATOR_TRUST_ENV=0

# Optional
# DATA_DIR=./data
# DB_PATH=./data/app.db
# DEFAULT_QC_PER_BIN=20
# ANNOTATOR_CONCURRENCY=2

# 内部账号（首次启动若无用户则自动创建默认管理员，存在 SQLite）
# DEFAULT_ADMIN_USERNAME=admin
# DEFAULT_ADMIN_PASSWORD=admin123
# DEFAULT_ADMIN_DISPLAY_NAME=管理员
# AUTH_SESSION_DAYS=7
